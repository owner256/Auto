{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcle.example.invalid/schemas/zcle-scene-v1.schema.json",
  "title": "ZCLE Course and Scene Contract v1.0",
  "description": "Content-first contract; relative times are milliseconds. Audio file must be referenced from the HTML player location. Additional business metadata may be defined in a future schema version.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "courseId", "lessonId", "title", "language", "sourceOfTruth", "status", "width", "height", "durationMs", "audio", "captions", "scenes", "qualityGates", "estimatedAudience"],
  "properties": {
    "schemaVersion": {"const":"1.0.0"},
    "courseId": {"type":"string","minLength":3}, "lessonId":{"type":"string","minLength":3},
    "title":{"type":"string","minLength":3},"language":{"type":"string","minLength":2},
    "estimatedAudience":{"type":"string"}, "status":{"enum":["draft","prototype-not-published","review","approved","published"]},
    "sourceOfTruth": {"type":"object","additionalProperties":false,"required":["repository","ref","paths"],"properties":{"repository":{"type":"string"},"ref":{"type":"string"},"paths":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "width":{"type":"integer","minimum":320},"height":{"type":"integer","minimum":180},
    "durationMs":{"type":"integer","minimum":1},
    "audio":{"type":"object","additionalProperties":false,"required":["src","format","role","voiceQuality","note"],"properties":{"src":{"type":"string","minLength":3},"format":{"enum":["audio/mpeg","audio/ogg","audio/wav"]},"role":{"const":"master-clock"},"voiceQuality":{"enum":["robotic-placeholder","human-approved","professional-tts-approved"]},"note":{"type":"string"}}},
    "captions":{"type":"object","additionalProperties":false,"required":["source","granularity","status"],"properties":{"source":{"const":"scene.narration.text"},"granularity":{"enum":["scene","sentence","word"]},"status":{"enum":["prototype","review","approved"]}}},
    "scenes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/scene"}},
    "qualityGates":{"type":"object","additionalProperties":{"type":"boolean"}}
  },
  "$defs":{
    "cue":{"type":"object","additionalProperties":false,"required":["id","atMs","action","target"],"properties":{"id":{"type":"string","minLength":1},"atMs":{"type":"integer","minimum":0},"action":{"enum":["reveal","highlight","hide","camera","focus","pulse","transition"]},"target":{"type":"string"}}},
    "scene":{"type":"object","additionalProperties":false,"required":["id","order","part","title","mode","visualTemplate","narration","startMs","endMs","durationMs","headline","kicker","labels","accessibility","cues"],"properties":{
      "id":{"type":"string","pattern":"^scene-[0-9]{2}$"}, "order":{"type":"integer","minimum":1},"part":{"enum":["01","02"]},
      "title":{"type":"string","minLength":3},"mode":{"enum":["2D","2.5D","3D"]},
      "visualTemplate":{"enum":["hero","definition","ecosystem","board3d","pipeline","fde","chip3d","cores","clock","memory","workloads","buying","recap"]},
      "narration":{"type":"object","additionalProperties":false,"required":["text","startMs","endMs","voiceType"],"properties":{"text":{"type":"string","minLength":20},"startMs":{"type":"integer","minimum":0},"endMs":{"type":"integer","minimum":1},"voiceType":{"type":"string"}}},
      "startMs":{"type":"integer","minimum":0},"endMs":{"type":"integer","minimum":1},"durationMs":{"type":"integer","minimum":1},
      "headline":{"type":"string"},"kicker":{"type":"string"},"labels":{"type":"array","minItems":1,"items":{"type":"string"}},
      "accessibility":{"type":"object","additionalProperties":false,"required":["visualDescription"],"properties":{"visualDescription":{"type":"string"}}},
      "cues":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/cue"}}
    }}
  }
}
